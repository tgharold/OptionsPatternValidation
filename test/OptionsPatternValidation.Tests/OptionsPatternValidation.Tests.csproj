<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The supported LTS runtimes. .NET Framework 4.8.1 is opt-in with -p:IncludeNetFramework=true,
         because only Windows with the 4.8.1 runtime can run it. CI sets it on Windows. Elsewhere the
         property still checks that the net481 build compiles. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IncludeNetFramework)' == 'true'">$(TargetFrameworks);net481</TargetFrameworks>
    <!-- One language version for every target. .NET Framework would otherwise default to C# 7.3. -->
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.25" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptionsPatternValidation\OptionsPatternValidation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TestSettingsJson\*.json" />
    <EmbeddedResource Include="Json\AttributeValidated\Test1.json" />
    <EmbeddedResource Include="Json\AttributeValidated\Test2.json" />
    <EmbeddedResource Include="Json\Unvalidated\SimpleSettings1.json" />
    <EmbeddedResource Include="Json\Unvalidated\SimpleSettings2.json" />
  </ItemGroup>

</Project>
